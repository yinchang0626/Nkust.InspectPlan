{
  "App": {
    "SelfUrl": "https://localhost:44378",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.InspectPlan.com,http://localhost:4200,",
    "RedirectAllowedUrls": "http://localhost:4200,",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Data Source=../../InspectPlan.db;"
  },
  "AuthServer": {
    "Authority": "https://localhost:44378",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "InspectPlan_Swagger",
    "CertificatePassPhrase": "99091839-a244-45dc-8f59-ca9f9a970a4d"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "OnxOwU7CtTOAzbZk"
  }}